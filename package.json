{
  "name": "sumi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://your-website-or-github-repo.com",
  "author": {
    "name": "Nine",
    "email": "your.email@example.com",
    "url": "https://your-personal-website.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"electron electron/main.js\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "buffer": "^6.0.3",
    "electron-store": "^10.0.1",
    "music-metadata-browser": "^2.5.11",
    "tailwindcss": "^4.1.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.4"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.sumi.musicplayer",
    "productName": "Sumi Music Player",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "buildResources": "resources"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "icon": "public/icons/icon.png"
    }
  }
}
